{{- /* The install writes the machine's type there, and mothership reads it too */ -}}
{{- $machine := include "/etc/mothership/machine.toml" | fromToml -}}
sourceDir = {{ .chezmoi.sourceDir | quote }}
encryption = "age"

[age]
    useBuiltin = true
    identity = "~/.config/mothership/key.txt"
    recipientsFile = {{ joinPath .chezmoi.sourceDir "types" $machine.type "users" .chezmoi.username "recipients.txt" | quote }}

[data]
    profile = {{ $machine.type | quote }}
    user = {{ .chezmoi.username | quote }}
